mem.ishf.dev {
    # MCP server — API key auth handled in the app
    handle /mcp* {
        reverse_proxy memory-server:8000
    }

    # Health check — public, no auth
    handle /health {
        reverse_proxy memory-server:8000
    }

    # Dashboard — password auth handled in the app
    handle {
        reverse_proxy dashboard:8080
    }
}
