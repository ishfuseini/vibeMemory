# vibeMemory — Environment Variables
# Copy this file to .env and fill in your values.
# Usage: uv run python server.py (loads .env automatically if python-dotenv is installed)
# Or:    export $(cat .env | xargs) && uv run python server.py

# --- Qdrant ---
# URL of your Qdrant instance
QDRANT_URL=http://localhost:6333

# Name of the Qdrant collection to use
QDRANT_COLLECTION=memories

# --- Embedding ---
# FastEmbed model name (384-dim, CPU-friendly)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Memory Behavior ---
# Cosine similarity threshold above which two memories are merged (0.0–1.0)
SIMILARITY_THRESHOLD=0.92

# Maximum characters to store per memory (text is truncated at this length)
MAX_TEXT_LEN=2000

# --- Dashboard ---
# URL the dashboard uses to reach the memory server (set in compose or shell)
MEMORY_SERVER_URL=http://localhost:8000

# --- Optional: Hugging Face token (avoids rate limits on model downloads) ---
# HF_TOKEN=hf_...
